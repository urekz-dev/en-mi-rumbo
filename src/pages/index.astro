---
// The site root (ADR 0007; docs/specs/public-directory.md, "While there is one
// active locality, the root and the alias redirect to it (v2)"). It reads the
// active localities through the cached HYPERDRIVE, like every public page:
// - exactly one: a 301 to its home, such as /hidalgo/tizayuca;
// - two or more: the list of localities, which EMR-29 builds here; until
//   then, the placeholder;
// - none (production before launch): the notice that the directory is coming,
//   with 200 ("With no active locality the root says the directory is coming
//   (v2)"), as the deploy smoke test and the availability check expect.
import { env, waitUntil } from "cloudflare:workers";
import ComingSoon from "../components/ComingSoon.astro";
import { withDb } from "../core/db/client.ts";
import { localityPath } from "../core/locality/paths.ts";
import { rootDestination } from "../core/locality/root.ts";
import { activeLocalities } from "../core/locality/served.ts";
import { permanentRedirect } from "../lib/locality.ts";

const active = await withDb(env, "HYPERDRIVE", { waitUntil }, (db) => activeLocalities(db));
const destination = rootDestination(active);
if (destination.kind === "locality") {
  return permanentRedirect(localityPath(destination.locality));
}
---

<ComingSoon />
