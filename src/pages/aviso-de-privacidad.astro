---
// The full privacy notice (docs/specs/legal-pages.md, "Full privacy notice
// page at `/aviso-de-privacidad`"). It belongs to no locality and names none,
// so it is prerendered at build time, without reading the database, and
// Cloudflare serves it as a static asset (ADR 0003). Indexable: it asks
// search engines nothing of its own; until the cut-over the deployed
// environments add their noindex header through the `_headers` file of the
// build (src/integrations/static-noindex.ts). The version comes from
// src/core/legal/version.ts, never written here.
import LegalDocument from "../components/LegalDocument.astro";
import { PRIVACY_NOTICE, PRIVACY_NOTICE_PAGE } from "../core/legal/privacy-notice.ts";
import { NOTICE_VERSION } from "../core/legal/version.ts";
import BaseLayout from "../layouts/BaseLayout.astro";

export const prerender = true;
---

<BaseLayout title={PRIVACY_NOTICE_PAGE.title} description={PRIVACY_NOTICE_PAGE.description}>
  <LegalDocument document={PRIVACY_NOTICE} version={NOTICE_VERSION} />
</BaseLayout>
