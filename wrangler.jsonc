// Local development and builds only. Environments (dev, stage, production),
// their routes and the hourly Cron Trigger arrive with the deployment stories.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Local name only. Each environment sets its own Worker name (dev-enmirumbo,
  // stage-enmirumbo, enmirumbo), so a deploy without --env never touches them.
  "name": "enmirumbo-local",
  // Custom entry: Astro's fetch handler plus the scheduled handler.
  "main": "./src/worker.ts",
  // Node.js compatibility is on by default from 2026-08-04.
  "compatibility_date": "2026-10-01",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
  },
  // Local-only values. The real Hyperdrive configuration ids per environment
  // (dev, stage, prod) arrive with EMR-15, inside each environment block.
  // The all-zero id is a placeholder and `localConnectionString` points both
  // bindings at the PostgreSQL 18 in compose.yaml (`vp run db:up`).
  // HYPERDRIVE is cached: public reads only. HYPERDRIVE_FRESH has caching
  // disabled: writes, the admin panel and any read that follows a write.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgres://enmirumbo:enmirumbo@localhost:5432/enmirumbo",
    },
    {
      "binding": "HYPERDRIVE_FRESH",
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgres://enmirumbo:enmirumbo@localhost:5432/enmirumbo",
    },
  ],
  // Local values. Wrangler environments do not inherit vars, so each deployed
  // environment declares its own.
  "vars": {
    // local, dev, stage or prod. Only "local" lets /admin open with the fixed
    // identity admin@enmirumbo.test, and only on a loopback host (ADR 0010).
    "ENVIRONMENT": "local",
    // Cloudflare Access: the team domain and the AUD tag of the admin
    // application. Locally the panel does not check them.
    "ACCESS_TEAM_DOMAIN": "urekz.cloudflareaccess.com",
    "ACCESS_AUD": "",
  },
}
