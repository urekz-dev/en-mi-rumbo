---
// The trades of a card (docs/specs/public-directory.md, "From the card the
// pages of its trades are reached"): each one the admin assigned, with the
// curated phrase of the trade, as a link to its page in the card's locality,
// so the trade pages are reachable by browsing and crawlable without the
// sitemap. The card is published, so the page of each of its trades lists at
// least this business: it is never one of the empty, non-indexed pages. A
// card without trades shows nothing, like any field the business did not
// fill in. Each link is at least 44px tall. No client JavaScript.
import type { CardTrade } from "../core/business/card.ts";
import { tradePhrase } from "../core/catalogue/trade-phrases.ts";
import { localityPath, type LocalityRef } from "../core/locality/paths.ts";

interface Props {
  trades: readonly CardTrade[];
  /** The card's locality, whose trade pages the links lead to. */
  locality: LocalityRef;
}

const { trades, locality } = Astro.props;
---

{trades.length > 0 && (
  <nav aria-label="Lo que hace este negocio">
    <ul class="flex flex-wrap gap-2">
      {trades.map((trade) => (
        <li>
          <a
            href={localityPath(locality, trade.slug)}
            class="inline-flex min-h-11 items-center rounded-full border border-line px-4 text-sm font-semibold break-words text-ink-muted transition-colors hover:bg-surface"
          >
            {tradePhrase(trade)}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
