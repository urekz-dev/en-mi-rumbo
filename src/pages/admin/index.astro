---
// Placeholder for the admin panel: shows who signed in through Cloudflare
// Access, so the flow can be seen end to end. The review queue arrives with its
// stories. src/middleware.ts has already verified the token and set
// Astro.locals.admin.
import { forbiddenResponse } from "../../lib/access/admin-gate.ts";
import BaseLayout from "../../layouts/BaseLayout.astro";

const admin = Astro.locals.admin;
if (admin === undefined) {
  // Second line of defense: never render the panel without an identity.
  return forbiddenResponse();
}
---

<BaseLayout title="Panel de revisión">
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="strict-origin" />
  </Fragment>
  <section class="flex flex-1 flex-col justify-center gap-4">
    <h1 class="text-3xl font-bold">Panel de enmirumbo</h1>
    <p class="text-lg">Entraste con este correo:</p>
    <p class="text-lg font-semibold break-all" data-testid="admin-email">
      {admin.email}
    </p>
    <p class="text-ink-muted">
      Aquí vas a revisar los registros de los negocios. Todavía lo estamos armando.
    </p>
  </section>
</BaseLayout>
